# 本機用 IDE 直接跑 service/main.go 的設定
#
# 坑 1：godotenv 讀的是「程式執行時的工作目錄」，不是原始碼所在目錄。
#       GoLand/IDEA 的 Run Configuration 裡 Working directory 要設成這個檔案
#       所在的目錄（也就是 Demo-Golang/），不然會讀不到、印出「未找到 .env 檔」。
#
# 坑 2：SEP 在叢集內部，host 直接連不到 *.svc.cluster.local，二選一：
#       (a) 只測 Service 自己的邏輯 → 起一個假的接收端，指向 localhost
#       (b) 要測真的 SEP → kubectl port-forward svc/sep-engine-svc 19090:8080 -n ns-sep-stg
#           （或直接用 OrbStack 的叢集 DNS，見 Test/api.cluster-direct.http，不用開 port-forward）
#       用 port-forward 時兩種都用 19090，避開 Service 自己佔用的 8080
#
# 坑 3（這台機器實測遇到）：OrbStack 自己會常駐佔用 127.0.0.1:8080，
#       跟 Service 預設監聽的 8080 衝突，打 localhost:8080 容易打到 OrbStack
#       而不是 Service，收到的 404 長得很像路由沒註冊，很容易誤判。
#       用 PORT 換成別的 port 避開，Test/api.http 的 @ideHost 要跟著改。

PORT=8081
SEP_ENDPOINT=http://sep-engine-svc.ns-sep-stg.svc.cluster.local:8080/api/run
SYSTEM_ID=demo-go
# local/ 前綴代表純本機 build（ci.sh 的預設行為），沒有 push 去任何 registry
BATCH_IMAGE_EMAILBATCH=local/emailbatch:git-b00ef34
BATCH_IMAGE_LINEBATCH=local/linebatch:git-b00ef34
BATCH_IMAGE_ERRORBATCH=local/errorbatch:git-b00ef34

# Job 要建在哪個 namespace。留空則交給 SEP 決定（會落在 SEP 自己的 ns-sep-stg）
JOB_NAMESPACE=ns-demo-go-stg
