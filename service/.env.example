# 本機跑這支 Service 要監聽的 port。預設 8080，但如果本機 8080 已經被別的東西佔用
# （例如 OrbStack 自己常駐在 127.0.0.1:8080），留空或刪掉這行會用預設值 8080，
# 建議本機開發時換一個，例如 8081，並記得 Test/api.http 的 @ideHost 要跟著改
PORT=8081

SEP_ENDPOINT=http://sep-engine-svc.ns-sep-stg.svc.cluster.local:8080/api/run
SYSTEM_ID=demo-go

# Job 要建在哪個 namespace。留空則交給 SEP 決定（會落在 SEP 自己的 namespace）
JOB_NAMESPACE=ns-demo-go-stg

# 必須使用 immutable tag（git-<short sha>），絕對不要用 :latest
# 用 :latest 會導致「CI 一 build 完，還沒 deploy 就跑到新版」
# 三支都要設，呼叫端打 /api/callsep 時「必須」用 batch_kind 參數指定要跑哪一支，
# 沒有預設值，不帶 batch_kind 會回 400
# local/ 前綴代表純本機 build、沒有 push 去任何 registry（ci.sh 的預設行為）
BATCH_IMAGE_EMAILBATCH=local/emailbatch:git-a1b2c3d
BATCH_IMAGE_LINEBATCH=local/linebatch:git-a1b2c3d
BATCH_IMAGE_ERRORBATCH=local/errorbatch:git-a1b2c3d
